{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_version", "tarea", "head_sha", "contexto_autorizado", "resultado_previo", "origen", "destinatario", "modo", "mutaciones_permitidas", "operaciones_permitidas", "impacto_economico", "reintentos", "transiciones_permitidas", "estado_canonico", "operaciones_delegadas_a_humanos", "profundidad_cadena"],
  "properties": {
    "handoff_version": { "const": "2" },
    "tarea": { "type": "string", "minLength": 1 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contexto_autorizado": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "resultado_previo": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["issue", "marker", "result_sha256"],
          "properties": {
            "issue": { "type": "integer", "minimum": 1 }, "marker": { "type": "string", "minLength": 1 },
            "result_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "origen": {
      "type": "object", "additionalProperties": false, "required": ["ejecutor", "rol"],
      "properties": { "ejecutor": { "type": "string" }, "rol": { "type": "string" } }
    },
    "destinatario": { "$ref": "#/$defs/actorDescriptor" },
    "modo": { "enum": ["solo_lectura", "ejecucion"] },
    "mutaciones_permitidas": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "operaciones_permitidas": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["tipo", "objetivo"],
        "properties": { "tipo": { "enum": ["git", "github", "red", "filesystem"] }, "objetivo": { "type": "string", "minLength": 1 } }
      }
    },
    "impacto_economico": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["tipo"], "properties": { "tipo": { "const": "no_aplica" } } },
        {
          "type": "object", "additionalProperties": false,
          "required": ["tipo", "objetivo_economico", "moneda", "cap_acumulado", "maximo_intento", "acumulado_observable", "remanente", "politica_costo_indeterminado"],
          "properties": {
            "tipo": { "const": "aplica" }, "objetivo_economico": { "type": "string" }, "moneda": { "type": "string" },
            "cap_acumulado": { "type": "number", "minimum": 0 }, "maximo_intento": { "type": "number", "minimum": 0 },
            "acumulado_observable": { "type": "number", "minimum": 0 }, "remanente": { "type": "number", "minimum": 0 },
            "politica_costo_indeterminado": { "const": "DETENER_SIN_REINTENTO" }
          }
        }
      ]
    },
    "reintentos": {
      "type": "object", "additionalProperties": false, "required": ["maximos", "politica_costo_indeterminado"],
      "properties": { "maximos": { "type": "integer", "minimum": 0 }, "politica_costo_indeterminado": { "const": "DETENER_SIN_REINTENTO" } }
    },
    "transiciones_permitidas": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "estado_canonico": {
      "type": "object", "additionalProperties": false,
      "required": ["accion_anterior", "evidencia_cierre", "proxima_accion", "head_reconciliacion"],
      "properties": {
        "accion_anterior": { "$ref": "#/$defs/actionIdentity" },
        "evidencia_cierre": {
          "type": "object", "additionalProperties": false, "required": ["tipo", "referencia", "head_o_historial"],
          "properties": {
            "tipo": { "enum": ["PR_INTEGRADA", "COMMIT", "ARTEFACTO_CON_HASH", "RESULTADO_VALIDADO"] },
            "referencia": { "type": "string" }, "head_o_historial": { "type": "string" }
          }
        },
        "proxima_accion": { "$ref": "#/$defs/actionIdentity" },
        "head_reconciliacion": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "paths_senal": { "type": "array", "items": { "type": "string" } }
      }
    },
    "operaciones_delegadas_a_humanos": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["categoria", "referencia_canonica", "condicion_observable", "actor_o_capacidad_requerida", "naturaleza"],
        "properties": {
          "categoria": { "enum": ["CAMBIO_DE_PRODUCTO_ALCANCE_O_INTENCION", "COSTO_RELEVANTE_O_PAYG", "PRIVACIDAD_O_SEGURIDAD_ACEPTADA", "ACCION_IRREVERSIBLE_O_IMPACTO_EXTERNO", "ALTERNATIVAS_MATERIALES_NO_RESUELTAS_POR_EVIDENCIA", "CONTRADICCION_CON_INSTRUCCION_DEL_DIRECTOR", "EVIDENCIA_INSUFICIENTE_PARA_GATE_OBLIGATORIO", "ACCION_FISICA_O_AUTORIZACION_NO_AUTOMATIZABLE"] },
          "referencia_canonica": { "type": "string" }, "condicion_observable": { "type": "string" },
          "actor_o_capacidad_requerida": { "type": "string" },
          "naturaleza": { "enum": ["DECISION_MATERIAL", "ACCION_FISICA", "OPERACION_RUTINARIA"] },
          "explicacion": { "type": "string" }
        }
      }
    },
    "profundidad_cadena": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "modo": { "const": "solo_lectura" } }, "required": ["modo"] },
      "then": { "properties": { "mutaciones_permitidas": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "actorDescriptor": {
      "type": "object", "additionalProperties": false, "required": ["rol", "capacidades_requeridas"],
      "properties": { "rol": { "type": "string" }, "capacidades_requeridas": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } }
    },
    "actionIdentity": {
      "type": "object", "additionalProperties": false, "required": ["id", "descripcion"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "descripcion": { "type": "string", "minLength": 1 } }
    }
  }
}
