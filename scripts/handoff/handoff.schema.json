{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_version",
    "tarea",
    "destinatario",
    "head_sha",
    "contexto_autorizado",
    "resultado_previo",
    "origen",
    "salida_requerida",
    "modo",
    "profundidad_cadena"
  ],
  "properties": {
    "handoff_version": { "const": "1" },
    "tarea": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "destinatario": { "enum": ["claude", "codex"] },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_ref": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "contexto_autorizado": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
    },
    "resultado_previo": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["issue", "marker", "result_sha256"],
          "properties": {
            "issue": { "type": "integer", "minimum": 1 },
            "marker": { "type": "string", "minLength": 1 },
            "result_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "origen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "ejecutor", "rol", "modelo", "esfuerzo", "issue_origen"],
      "properties": {
        "tipo": { "enum": ["agente", "puente"] },
        "ejecutor": { "enum": ["claude", "handoff.mjs"] },
        "rol": { "enum": ["arquitecto", "orquestador"] },
        "modelo": { "type": ["string", "null"] },
        "esfuerzo": { "type": ["string", "null"] },
        "issue_origen": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "salida_requerida": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "modo": { "const": "solo_lectura" },
    "profundidad_cadena": { "type": "integer", "minimum": 1 }
  }
}
