{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Handoff manifest v2", "type": "object", "additionalProperties": false,
  "required": ["artifact_id", "head_sha", "contract_sha256", "producer", "request", "sources", "producer_chain"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 }, "head_sha": { "$ref": "#/$defs/sha40" }, "contract_sha256": { "$ref": "#/$defs/sha256" },
    "producer": { "$ref": "#/$defs/producerIdentity" },
    "request": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "content"], "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 }, "content": { "type": "string", "minLength": 1 } } },
    "sources": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/versionedSource" }, { "$ref": "#/$defs/generatedSource" }] } },
    "producer_chain": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["profile_id", "producer_id", "kind", "path", "head_sha", "git_blob_oid", "sha256", "bytes"], "properties": { "profile_id": { "type": "string" }, "producer_id": { "type": "string" }, "kind": { "type": "string" }, "path": { "type": "string" }, "head_sha": { "$ref": "#/$defs/sha40" }, "git_blob_oid": { "$ref": "#/$defs/sha40" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 } } } },
    "coverage_binding": { "$ref": "handoff-attempt-v2.schema.json#/$defs/coverageBinding" }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "producerIdentity": { "type": "object", "additionalProperties": false, "required": ["role_id", "surface_id", "adapter", "cwd"], "properties": { "role_id": { "type": "string" }, "surface_id": { "type": "string" }, "adapter": { "type": "string" }, "cwd": { "type": "string" } } },
    "versionedSource": { "type": "object", "additionalProperties": false, "required": ["kind", "head_sha", "path", "git_blob_oid", "sha256", "bytes"], "properties": { "kind": { "const": "versioned" }, "head_sha": { "$ref": "#/$defs/sha40" }, "path": { "type": "string" }, "git_blob_oid": { "$ref": "#/$defs/sha40" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 } } },
    "generatedSource": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "bytes", "producer_id"], "properties": { "kind": { "const": "generated" }, "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 }, "producer_id": { "type": "string" } } }
  }
}
