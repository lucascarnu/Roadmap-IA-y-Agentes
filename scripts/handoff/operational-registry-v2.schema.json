{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Operational surface registry v2", "type": "object", "additionalProperties": false,
  "required": ["version", "surfaces"], "properties": { "version": { "const": "2" }, "surfaces": { "type": "object", "additionalProperties": { "$ref": "#/$defs/surface" } } },
  "$defs": {
    "statusOperations": { "type": "object", "additionalProperties": false, "required": ["status", "operations"], "properties": { "status": { "type": "string", "minLength": 1 }, "operations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "surface": { "type": "object", "additionalProperties": false, "required": ["role_id", "assignment_ref", "adapter", "cwd", "surface_type", "invocable", "observed_capabilities", "authorization", "authentication", "compatibility", "operational_profile", "confinement", "provenance"], "properties": {
      "role_id": { "type": "string" }, "assignment_ref": { "type": "string" }, "adapter": { "type": "string" }, "cwd": { "type": "string" }, "surface_type": { "type": "string" }, "invocable": { "type": "boolean" }, "observed_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
      "authorization": { "$ref": "#/$defs/statusOperations" }, "authentication": { "type": "object", "additionalProperties": false, "required": ["status", "routes"], "properties": { "status": { "enum": ["AUTENTICADA", "NO_AUTENTICADA", "NO_APLICA"] }, "routes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } } }, "compatibility": { "$ref": "#/$defs/statusOperations" },
      "operational_profile": { "type": "object", "additionalProperties": false, "required": ["profile_id", "evidence"], "properties": { "profile_id": { "enum": ["manual", "github_close", "puente", "review", "humano"] }, "evidence": { "type": "string" } } },
      "confinement": { "type": "object", "additionalProperties": false, "required": ["mechanism", "evidence"], "properties": { "mechanism": { "type": "string" }, "evidence": { "const": "NO_PROBADO" } } },
      "provenance": { "type": "object", "additionalProperties": false, "required": ["date", "scope", "source"], "properties": { "date": { "type": "string" }, "scope": { "type": "string" }, "source": { "type": "string" } } }
    } }
  }
}
