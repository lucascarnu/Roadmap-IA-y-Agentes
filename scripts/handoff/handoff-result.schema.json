{
  "title": "Handoff result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_version",
    "estado",
    "veredicto",
    "resumen",
    "evidencia",
    "archivos_leidos",
    "accion_recomendada",
    "siguiente_destinatario",
    "firma"
  ],
  "properties": {
    "handoff_version": { "type": "string", "enum": ["1"] },
    "estado": { "type": "string", "enum": ["COMPLETADO", "BLOQUEADO"] },
    "veredicto": { "type": "string" },
    "resumen": { "type": "string" },
    "evidencia": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["archivo", "detalle"],
        "properties": {
          "archivo": { "type": "string" },
          "detalle": { "type": "string" }
        }
      }
    },
    "archivos_leidos": {
      "type": "array",
      "items": { "type": "string" }
    },
    "accion_recomendada": { "type": "string" },
    "siguiente_destinatario": { "type": ["string", "null"], "enum": ["claude", "codex", "kimi", null] },
    "firma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ejecutor", "modelo", "esfuerzo", "head_sha"],
      "properties": {
        "ejecutor": { "type": "string", "enum": ["claude", "codex", "kimi"] },
        "modelo": { "type": "string" },
        "esfuerzo": { "type": "string" },
        "head_sha": { "type": "string" }
      }
    }
  }
}
