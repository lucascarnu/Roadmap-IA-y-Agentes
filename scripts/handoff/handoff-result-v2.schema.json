{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Handoff result v2", "type": "object", "additionalProperties": false,
  "required": ["handoff_version", "binding", "estado", "decision", "resumen", "evidencia", "archivos_leidos", "siguiente", "firma"],
  "properties": {
    "handoff_version": { "const": "2" }, "binding": { "type": "object", "additionalProperties": false, "required": ["attempt_id", "artifact_id", "request_sha256", "request_bytes", "manifest_sha256", "head_sha"], "properties": { "attempt_id": { "type": "string" }, "artifact_id": { "type": "string" }, "request_sha256": { "$ref": "#/$defs/sha256" }, "request_bytes": { "type": "integer", "minimum": 1 }, "manifest_sha256": { "$ref": "#/$defs/sha256" }, "head_sha": { "$ref": "#/$defs/sha40" } } },
    "estado": { "enum": ["COMPLETADO", "BLOQUEADO"] }, "decision": { "enum": ["SIN_OBJECIONES", "OBJECION_MATERIAL", "REQUIERE_ARBITRAJE", "BLOQUEADO_POR_LIMITE", "BLOQUEADO_POR_GATE"] }, "resumen": { "type": "string", "minLength": 1 },
    "evidencia": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["archivo", "detalle"], "properties": { "archivo": { "type": "string" }, "detalle": { "type": "string" } } } }, "archivos_leidos": { "type": "array", "items": { "type": "string" } }, "siguiente": { "oneOf": [{ "type": "null" }, { "$ref": "handoff-v2.schema.json#/$defs/target" }] },
    "firma": { "type": "object", "additionalProperties": false, "required": ["ejecutor_real", "entorno", "modelo_configurado", "modelo_efectivo", "esfuerzo_o_modo_configurado", "esfuerzo_o_modo_efectivo", "sujeto_evaluado", "via_evaluada", "fecha"], "properties": { "ejecutor_real": { "type": "string" }, "entorno": { "type": "string" }, "modelo_configurado": { "type": "string" }, "modelo_efectivo": { "type": "string" }, "esfuerzo_o_modo_configurado": { "type": "string" }, "esfuerzo_o_modo_efectivo": { "type": "string" }, "sujeto_evaluado": { "type": "string" }, "via_evaluada": { "type": "string" }, "fecha": { "type": "string" } } }
  },
  "$defs": { "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
