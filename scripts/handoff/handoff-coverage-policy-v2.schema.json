{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff-coverage-policy-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_version", "policies"],
  "properties": {
    "document_version": { "const": "1" },
    "policies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/policy" } }
  },
  "$defs": {
    "classification": { "enum": ["REQUERIDO_PARA_LA_TAREA", "REFERENCIA_DURABLE_RESOLUBLE", "CONTEXTO_NO_NECESARIO"] },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "classification", "locator", "search"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "classification": { "$ref": "#/$defs/classification" },
        "locator": { "type": "string", "minLength": 1 },
        "search": { "type": "object", "additionalProperties": false, "required": ["query", "expected_matches"], "properties": { "query": { "type": "string", "minLength": 1 }, "expected_matches": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } }
      }
    },
    "model": { "type": "object", "additionalProperties": false, "required": ["id", "evidence_requirement_ids"], "properties": { "id": { "type": "string", "minLength": 1 }, "evidence_requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } },
    "countModel": { "type": "object", "additionalProperties": false, "required": ["id", "expected", "evidence_requirement_ids"], "properties": { "id": { "type": "string", "minLength": 1 }, "expected": { "type": "integer", "minimum": 0 }, "evidence_requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "artifact_type", "version", "requirements", "models"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 }, "artifact_type": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 },
        "requirements": { "type": "object", "additionalProperties": false, "required": ["canon", "enumerations", "producers", "consumers", "schemas", "validators", "tests", "invariants"], "properties": { "canon": { "$ref": "#/$defs/requirementArray" }, "enumerations": { "$ref": "#/$defs/requirementArray" }, "producers": { "$ref": "#/$defs/requirementArray" }, "consumers": { "$ref": "#/$defs/requirementArray" }, "schemas": { "$ref": "#/$defs/requirementArray" }, "validators": { "$ref": "#/$defs/requirementArray" }, "tests": { "$ref": "#/$defs/requirementArray" }, "invariants": { "$ref": "#/$defs/requirementArray" } } },
        "models": { "type": "object", "additionalProperties": false, "required": ["counts", "facts", "decisions"], "properties": { "counts": { "type": "array", "items": { "$ref": "#/$defs/countModel" } }, "facts": { "type": "array", "items": { "$ref": "#/$defs/model" } }, "decisions": { "type": "array", "items": { "$ref": "#/$defs/model" } } } }
      }
    },
    "requirementArray": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
  }
}
