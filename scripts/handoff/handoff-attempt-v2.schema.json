{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Handoff attempt v2", "type": "object", "additionalProperties": false,
  "required": ["attempt_id", "transport_real_id", "artifact_id", "request_sha256", "request_bytes", "target", "head_sha", "manifest_sha256", "salida_requerida"],
  "properties": { "attempt_id": { "type": "string", "minLength": 1 }, "transport_real_id": { "type": "string", "minLength": 1 }, "artifact_id": { "type": "string", "minLength": 1 }, "request_sha256": { "$ref": "#/$defs/sha256" }, "request_bytes": { "type": "integer", "minimum": 1 }, "target": { "type": "object", "additionalProperties": false, "required": ["role_id", "surface_id"], "properties": { "role_id": { "type": "string", "minLength": 1 }, "surface_id": { "type": "string", "minLength": 1 } } }, "head_sha": { "$ref": "#/$defs/sha40" }, "manifest_sha256": { "$ref": "#/$defs/sha256" }, "salida_requerida": { "type": "string", "minLength": 1, "maxLength": 4000 }, "coverage_binding": { "$ref": "#/$defs/coverageBinding" } },
  "$defs": { "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "stringSet": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "coverageBinding": { "type": "object", "additionalProperties": false, "required": ["canonicalization_version", "profile_id", "artifact_type", "policy_id", "policy_version", "policy_sha256", "policy_bytes", "preflight_sha256", "preflight_bytes", "head_sha", "git_tree_oid", "resolution_target_sha256", "requirement_sets"], "properties": { "canonicalization_version": { "const": "1" }, "profile_id": { "type": "string", "minLength": 1 }, "artifact_type": { "type": "string", "minLength": 1 }, "policy_id": { "$ref": "#/$defs/sha256" }, "policy_version": { "type": "string", "minLength": 1 }, "policy_sha256": { "$ref": "#/$defs/sha256" }, "policy_bytes": { "type": "integer", "minimum": 1 }, "preflight_sha256": { "$ref": "#/$defs/sha256" }, "preflight_bytes": { "type": "integer", "minimum": 1 }, "head_sha": { "$ref": "#/$defs/sha40" }, "git_tree_oid": { "$ref": "#/$defs/sha40" }, "resolution_target_sha256": { "$ref": "#/$defs/sha256" }, "requirement_sets": { "$ref": "#/$defs/requirementSets" } } }, "requirementSets": { "type": "object", "additionalProperties": false, "required": ["canon", "enumerations", "producers", "consumers", "schemas", "validators", "tests", "invariants"], "properties": { "canon": { "$ref": "#/$defs/stringSet" }, "enumerations": { "$ref": "#/$defs/stringSet" }, "producers": { "$ref": "#/$defs/stringSet" }, "consumers": { "$ref": "#/$defs/stringSet" }, "schemas": { "$ref": "#/$defs/stringSet" }, "validators": { "$ref": "#/$defs/stringSet" }, "tests": { "$ref": "#/$defs/stringSet" }, "invariants": { "$ref": "#/$defs/stringSet" } } } }
}
